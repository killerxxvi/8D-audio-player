body {
  background: #0a0a0a;
  color: white;
  text-align: center;
  font-family: Arial;
  padding: 30px;
}

h1 {
  color: #1DB954;
}

button {
  background: #1DB954;
  color: white;
  border: none;
  padding: 12px 25px;
  margin: 8px;
  border-radius: 25px;
  cursor: pointer;
  font-size: 16px;
}

button:hover {
  background: #1aa34a;
}

audio {
  width: 80%;
  margin: 20px;
}
